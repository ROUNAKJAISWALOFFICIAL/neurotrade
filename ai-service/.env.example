# TradeEdge AI Service - Environment Variables

# ═════════════════════════════════════════════════════════════════
# CRITICAL: Required for signal generation with REAL data
# ═════════════════════════════════════════════════════════════════

# Upstox API Token
# Get from: https://upstox.com → Login → API Console → Generate Token
# DO NOT commit this to git!
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here


# ═════════════════════════════════════════════════════════════════
# OPTIONAL: AI-powered decision making (Gemini)
# ═════════════════════════════════════════════════════════════════

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikeys → Create API key
# If not provided, signals will use rule-based engine only
GEMINI_API_KEY=your_gemini_api_key_here


# ═════════════════════════════════════════════════════════════════
# Server Configuration (Optional)
# ═════════════════════════════════════════════════════════════════

# Server host (0.0.0.0 = accessible from other machines)
UVICORN_HOST=0.0.0.0

# Server port
UVICORN_PORT=8000

# Enable auto-reload on code changes (development only)
UVICORN_RELOAD=True

# Log level (debug, info, warning, error)
LOG_LEVEL=info
